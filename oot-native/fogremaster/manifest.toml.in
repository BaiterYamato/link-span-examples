id = "linkspan.fogremaster"
name = "FogreMaster"
version = "0.33.8"
api = ">=0.5.0 <0.6.0"
entrypoint = "main.lua"
games = ["oot"]
kind = "core_extension"
load_phase = "pre_game"

[capabilities]
optional = ["core.menu", "core.storage"]

[provider]
abi_version = "1.4"
@FOGREMASTER_PLATFORM@ = "provider/@FOGREMASTER_LIBRARY@"
host_layout_id = "@OOT_NATIVE_LAYOUT_ID@"
